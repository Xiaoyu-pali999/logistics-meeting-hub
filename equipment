  h+=row('要解决的问题',x.prob);
  h+=row('做法',x.do);
  h+=row('量化分级',QGLABEL[x.qg]);
  h+=row('量化结果（含前后对照）',x.res);
  h+=row('对照基线',x.base);
  h+=row('可信度 / 来源',x.cred+' —— '+x.src);
  h+=row('适用条件与局限',x.lim);
  h+=row('对应议题','<a href="javascript:void(0)" onclick="jumpTopicCase(\''+x.topic.replace(/'/g,"\\'")+'\')">'+x.topic+'（看本议题全部案例）</a>');
  h+=row('发言人及职务',x.sp);
  h+=row('会议 / 日期',x.meet+' ／ '+x.date);
  const sameIdx=CASES.map((y,i)=>({y,i})).filter(o=>o.i!==curI && o.y.c===x.c).map(o=>o.i);
  if(sameIdx.length){h+='<div class="crow"><span class="ck">同企业其他案例</span><span class="cv">'+sameIdx.map(i=>'<a href="javascript:void(0)" onclick="openCase('+i+')">'+CASES[i].n+'（'+CASES[i].meet+'）</a>').join('、')+'</span></div>';}
