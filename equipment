function heat(){
  let th='<tr><th class="hname">议题（按每万字均值降序）</th><th>每万字均值</th><th>被几场会议提到</th>';
  ['R1','R2','R3','R4'].forEach(r=>th+='<th>'+SHORT[r]+'</th>'); th+='<th>热度最高</th></tr>';
  let body='';
  ORDER.forEach(([tid,avg])=>{
    const nm=TOPICS.find(t=>t.id===tid).name;
    const ps4=['R1','R2','R3','R4'].map(r=>STATS[r].per[tid]); const mentions=ps4.filter(v=>v>=1.5).length; body+='<tr><td class="hname">'+nm+'</td><td class="avg">'+avg.toFixed(1)+'</td><td class="cnt">'+mentions+'/4</td>';
    ['R1','R2','R3','R4'].forEach(r=>{
      const h=STATS[r].hits[tid], p=STATS[r].per[tid];
      const dark = hidx(p) >= 4;
      body+='<td class="hnum'+(dark?' dark':'')+'" data-t="'+tid+'" data-r="'+r+'" style="background:'+HCOL[hidx(p)]+'"><span class="hn">'+h+'</span><span class="hp">'+p.toFixed(1)+' 次/万字</span></td>';
    });
    const ps=['R1','R2','R3','R4'].map(r=>STATS[r].per[tid]);
    const mx=Math.max(...ps); const hot=['R1','R2','R3','R4'].filter((r,i)=>ps[i]===mx).map(r=>SHORT[r]).join('/');
    body+='<td class="cnt">'+hot+'</td></tr>';
  });
  const tb=document.getElementById('heatTable'); tb.innerHTML=th+body;
  tb.querySelectorAll('td.hnum').forEach(c=>c.addEventListener('click',()=>openCell(c.dataset.t,c.dataset.r)));
}
function openCell(tid,r){
  const d=CELL[tid][r], nm=TOPICS.find(t=>t.id===tid).name;
  const h=STATS[r].hits[tid], p=STATS[r].per[tid];
  let fg=''; d.f.forEach(x=>fg+='<span class="badge '+ (x==='已核'?'ok':x==='出入'?'conf':'verify') +'">'+x+'</span>');
  const htm='<div class="card"><h3 style="margin:0 0 6px">'+nm+' · '+SHORT[r]+'</h3>'
    +'<div class="pt">议题对应该会议的原话摘要（转自会后报告）</div>'
    +'<div class="txt">'+d.t+'</div>'
    +'<div class="crow"><span class="ck">来源章节</span><span class="cv">'+cnTxt(d.s||'—')+'</span></div>'
    +'<div class="crow"><span class="ck">命中次数</span><span class="cv">'+h+' 次（'+p.toFixed(1)+' 次/万字）</span></div>'
