/* ===== 检索渲染 ===== */
let curTab="case";
let selSet=new Set();
const QGLABEL={A:'A·有基线效果量化',B:'B·效果数字但基线不清/目标',C:'C·规模/背景数字',D:'D·无量化'};
const qgTag=x=>'<span class="badge qg qg-'+x.qg+'">'+x.qg+'</span>';

function getFilteredRows(){
  const q=(document.getElementById('q').value||'').trim().toLowerCase();
  const fm=document.getElementById('fMeet').value;
  const fs=document.getElementById('fSt').value;
  const fq=document.getElementById('fQ').value;
  return CASES.map((x,i)=>({x,i})).filter(({x,i})=>{
    if(q && ![x.n,x.ty,x.c,x.ind,x.sc,x.tech,x.prob,x.do,x.res,x.src,x.topic,x.sp,x.meet,x.cite].join(' ').toLowerCase().includes(q)) return false;
    if(fm && x.meet!==fm) return false;
    if(fs && x.cred!==fs) return false;
    if(fq && x.qg!==fq) return false;
    return true;
  });
}
function exportSel(){
  const visible=getFilteredRows().filter(({i})=>selSet.has(i));
  if(!visible.length){alert('当前筛选结果中没有已勾选的案例');return;}
  const lines=visible.map(({x})=>{
    return '【'+x.n+'】('+x.c+'·'+x.meet+')\n'
      +'场景/技术：'+x.sc+'／'+x.tech+'\n'
      +'做法：'+x.do+'\n'
      +'量化分级：'+QGLABEL[x.qg]+'\n'
      +'可信度：'+x.cred+'（'+x.src+'）\n'
      +'使用限制：'+x.lim+'\n'
      +'引用：'+x.cite;
  });
  const blob=new Blob(['【案例引用导出】共'+visible.length+'条（仅含当前筛选结果中已勾选）\n\n'+lines.join('\n\n---\n\n')],{type:'text/plain;charset=utf-8'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='案例引用导出.txt';a.click();
}
function renderSearch(){
  const tabs=document.getElementById('searchTabs');
  const defs=[["case","案例",CASES.length],["data","数据口径",DATA.length],["guest","嘉宾",GUESTS.length]];
  let h=''; defs.forEach(([k,label,n])=>{h+='<button data-k="'+k+'" class="'+(k===curTab?'on':'')+'">'+label+'（'+n+'）</button>';});
  tabs.innerHTML=h;
  tabs.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>{curTab=b.dataset.k;renderSearch();}));
  const q=(document.getElementById('q').value||'').trim().toLowerCase();
  const filters=document.getElementById('caseFilters');
  filters.style.display=(curTab==='case')?'flex':'none';
  let out='';
  if(curTab==='case'){
    let rows=getFilteredRows();
    out='<table class="data caseTable"><colgroup><col style="width:3%"><col style="width:13%"><col style="width:8%"><col style="width:9%"><col style="width:8%"><col style="width:10%"><col style="width:28%"><col style="width:11%"><col style="width:10%"></colgroup><tr><th></th><th>案例</th><th>类型</th><th>企业/主体</th><th>场景</th><th>技术类型</th><th>量化结果</th><th>可信度</th><th>议题</th></tr>';
    rows.forEach(({x,i})=>{
      const bg=x.cred==='速记一致'?'ok':x.cred==='出入'?'conf':'verify';
      const chk=selSet.has(i)?'checked':'';
      out+='<tr class="clickable" data-ci="'+i+'" style="cursor:pointer"><td><input type="checkbox" class="csel" data-i="'+i+'" '+chk+' onclick="event.stopPropagation()"></td><td><b>'+x.n+'</b></td><td>'+x.ty+'</td><td>'+x.c+'</td><td>'+x.sc+'</td><td>'+x.tech+'</td><td class="note">'+qgTag(x)+' '+x.res+'</td><td><span class="badge '+bg+'">'+x.cred+'</span></td><td>'+x.topic+'</td></tr>';
    });
    out+='</table>';
    out+='<div class="caseCards">';
    rows.forEach(({x,i})=>{
      const bg=x.cred==='速记一致'?'ok':x.cred==='出入'?'conf':'verify';
      const chk=selSet.has(i)?'checked':'';
      out+='<div class="ccard clickable" data-ci="'+i+'"><div class="ccard-top"><input type="checkbox" class="csel" data-i="'+i+'" '+chk+' onclick="event.stopPropagation()"><b>'+x.n+'</b>'+qgTag(x)+'<span class="badge '+bg+'">'+x.cred+'</span></div><div class="muted">'+x.c+' ／ '+x.ind+' ／ '+x.sc+'</div><div class="note">'+x.res+'</div><div class="muted">'+x.meet+' · '+x.sp+'</div></div>';
    });
    out+='</div>';
    out+='<p class="muted" style="margin-top:8px">点击任意行查看完整档案；勾选后点"导出所选引用"导出 .txt（含场景/做法/量化结果/可信度/使用限制）。量化分级：A=有基线效果量化（可对比引用）／B=效果数字但基线不清或目标／C=规模背景数字／D=无量化。可信度：外部核实＝年报/官网/政府协会统计/权威媒体对上；速记一致＝嘉宾确实这么说但未外部核实；仅报告转述＝无速记对证。</p>';
    setTimeout(()=>{
      document.getElementById('selCount').textContent='已选 '+selSet.size+' 条';
      rows.forEach(({i})=>{const tr=document.querySelector('tr.clickable[data-ci="'+i+'"]');if(tr)tr.addEventListener('click',()=>openCase(i));});
      document.querySelectorAll('.ccard.clickable').forEach(c=>c.addEventListener('click',()=>openCase(+c.dataset.ci)));
      document.querySelectorAll('.csel').forEach(c=>c.addEventListener('change',()=>{const i=+c.dataset.i; if(c.checked)selSet.add(i);else selSet.delete(i);document.getElementById('selCount').textContent='已选 '+selSet.size+' 条';}));
    },0);
  } else if(curTab==='data'){
    filters.style.display='none';
    let rows=DATA.filter(r=>!q||(r[0]+r[1]+r[2]+r[3]+r[4]+r[5]+r[6]).toLowerCase().includes(q));
    out='<table class="data"><colgroup><col style="width:13%"><col style="width:5%"><col style="width:30%"><col style="width:13%"><col style="width:14%"><col style="width:12%"><col style="width:13%"></colgroup><tr><th>指标组</th><th>会议</th><th>数值</th><th>口径说明</th><th>出处</th><th>状态</th><th>备注</th></tr>';
    rows.forEach(r=>{out+='<tr><td>'+r[0]+'</td><td>'+cn(r[1])+'</td><td>'+r[2]+'</td><td class="note">'+r[3]+'</td><td>'+cnTxt(r[4])+'</td><td class="note">'+r[5]+'</td><td class="note">'+cnTxt(r[6])+'</td></tr>';});
    out+='</table>';
  } else {
    filters.style.display='none';
    let rows=GUESTS.filter(r=>!q||(r[0]+r[1]+r[2]+r[3]+r[4]).toLowerCase().includes(q));
    out='<table class="data"><colgroup><col style="width:9%"><col style="width:22%"><col style="width:15%"><col style="width:12%"><col style="width:42%"></colgroup><tr><th>姓名</th><th>机构/职务</th><th>出现会议</th><th>角色</th><th>跨场一致性标注</th></tr>';
    rows.forEach(r=>{out+='<tr><td>'+r[0]+'</td><td>'+r[1]+'</td><td>'+cn(r[2])+'</td><td>'+r[3]+'</td><td class="note">'+cnTxt(r[4])+'</td></tr>';});
    out+='</table>';
  }
  document.getElementById('searchOut').innerHTML=out||'<p class="muted">无匹配结果。</p>';
}
document.getElementById('q').addEventListener('input',()=>renderSearch());
['fMeet','fSt','fQ'].forEach(id=>{const e=document.getElementById(id);if(e)e.addEventListener('change',()=>renderSearch());});
document.getElementById('exportSel').addEventListener('click',exportSel);
document.getElementById('selAll').addEventListener('change',e=>{
  const boxes=document.querySelectorAll('.csel');
  boxes.forEach(c=>{c.checked=e.target.checked;const i=+c.dataset.i;if(e.target.checked)selSet.add(i);else selSet.delete(i);});
  document.getElementById('selCount').textContent='已选 '+selSet.size+' 条';
});
/* ===== 初始化 ===== */
legend(); heat(); homeLists(); route(); renderSearch();
</script>
</body>
